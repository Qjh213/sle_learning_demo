+static const uint8_t g_sle_own_addr_fallback[SLE_ADDR_LEN] = { 0x01, 0x02, 0x03, 0x04, 0x05, 0x06 };
+
+/* 读取本机真实地址；读取失败或地址全 0 时回退到演示用固定地址 */
+static void sle_fill_own_addr(sle_addr_t *out)
+{
+    errcode_t ret;
+    uint8_t index;
+    uint8_t all_zero = 1;
+
+    ret = sle_get_local_addr(out);
+    if (ret == ERRCODE_SLE_SUCCESS) {
+        for (index = 0; index < SLE_ADDR_LEN; index++) {
+            if (out->addr[index] != 0) {
+                all_zero = 0;
+                break;
+            }
+        }
+    }
+    if (ret != ERRCODE_SLE_SUCCESS || all_zero != 0) {
+        (void)memcpy_s(out->addr, SLE_ADDR_LEN, g_sle_own_addr_fallback, SLE_ADDR_LEN);
+        out->type = SLE_ADDRESS_TYPE_PUBLIC;
+        sample_at_log_print("%s get local addr failed, use fallback\r\n", SLE_UART_SERVER_LOG);
+    }
+}
